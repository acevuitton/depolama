import SwiftUI
import Photos

struct ContentView: View {
    @State private var manager = PhotoLibraryManager()
    @State private var sortOrder: MediaSortOrder = .sizeAscending
    @State private var filter: MediaFilter = .all
    @State private var selection = Set<String>()
    @State private var showDeleteConfirm = false

    private var filteredSorted: [MediaAsset] {
        let filtered: [MediaAsset]
        switch filter {
        case .all:    filtered = manager.assets
        case .photos: filtered = manager.assets.filter { !$0.isVideo }
        case .videos: filtered = manager.assets.filter { $0.isVideo }
        }

        switch sortOrder {
        case .sizeAscending:  return filtered.sorted { $0.sizeBytes < $1.sizeBytes }
        case .sizeDescending: return filtered.sorted { $0.sizeBytes > $1.sizeBytes }
        case .dateNewest:     return filtered.sorted { ($0.creationDate ?? .distantPast) > ($1.creationDate ?? .distantPast) }
        case .dateOldest:     return filtered.sorted { ($0.creationDate ?? .distantPast) < ($1.creationDate ?? .distantPast) }
        }
    }

    private var totalSize: Int64 {
        filteredSorted.reduce(0) { $0 + $1.sizeBytes }
    }

    private var selectedSize: Int64 {
        filteredSorted
            .filter { selection.contains($0.id) }
            .reduce(0) { $0 + $1.sizeBytes }
    }

    var body: some View {
        NavigationStack {
            Group {
                switch manager.authorizationStatus {
                case .notDetermined:
                    permissionRequestView
                case .denied, .restricted:
                    permissionDeniedView
                case .authorized, .limited:
                    mainListView
                @unknown default:
                    permissionRequestView
                }
            }
            .navigationTitle("Galeri Düzenleyici")
            .toolbar { toolbarContent }
            .confirmationDialog(
                "\(selection.count) öğe silinsin mi?",
                isPresented: $showDeleteConfirm,
                titleVisibility: .visible
            ) {
                Button("Sil", role: .destructive) {
                    Task {
                        let toDelete = manager.assets.filter { selection.contains($0.id) }
                        await manager.delete(toDelete)
                        selection.removeAll()
                    }
                }
                Button("Vazgeç", role: .cancel) {}
            } message: {
                Text("Toplam \(ByteCountFormatter.string(fromByteCount: selectedSize, countStyle: .file)) yer boşalacak. Bu işlem geri alınamaz.")
            }
            .alert(
                "Hata",
                isPresented: Binding(
                    get: { manager.errorMessage != nil },
                    set: { if !$0 { manager.errorMessage = nil } }
                ),
                presenting: manager.errorMessage
            ) { _ in
                Button("Tamam", role: .cancel) {}
            } message: { msg in
                Text(msg)
            }
        }
        .task {
            if manager.authorizationStatus == .notDetermined {
                await manager.requestAuthorization()
            } else if manager.assets.isEmpty &&
                        (manager.authorizationStatus == .authorized ||
                         manager.authorizationStatus == .limited) {
                await manager.loadAssets()
            }
        }
    }

    // MARK: - Subviews

    @ToolbarContentBuilder
    private var toolbarContent: some ToolbarContent {
        ToolbarItem(placement: .topBarLeading) {
            if !selection.isEmpty {
                Button(role: .destructive) {
                    showDeleteConfirm = true
                } label: {
                    Label("Sil (\(selection.count))", systemImage: "trash")
                }
                .tint(.red)
            }
        }
        ToolbarItem(placement: .topBarTrailing) {
            Menu {
                Picker("Sırala", selection: $sortOrder) {
                    ForEach(MediaSortOrder.allCases) { order in
                        Text(order.label).tag(order)
                    }
                }
                Divider()
                Picker("Filtre", selection: $filter) {
                    ForEach(MediaFilter.allCases) { f in
                        Text(f.label).tag(f)
                    }
                }
            } label: {
                Image(systemName: "line.3.horizontal.decrease.circle")
            }
        }
    }

    private var permissionRequestView: some View {
        VStack(spacing: 16) {
            Image(systemName: "photo.on.rectangle.angled")
                .font(.system(size: 60))
                .foregroundStyle(.secondary)
            Text("Galeri erişimi gerekli")
                .font(.headline)
            Button("İzin Ver") {
                Task { await manager.requestAuthorization() }
            }
            .buttonStyle(.borderedProminent)
        }
        .padding()
    }

    private var permissionDeniedView: some View {
        VStack(spacing: 16) {
            Image(systemName: "lock.fill")
                .font(.system(size: 60))
                .foregroundStyle(.secondary)
            Text("Galeri erişimi reddedildi")
                .font(.headline)
            Text("Ayarlar'dan izin verebilirsin.")
                .font(.subheadline)
                .foregroundStyle(.secondary)
                .multilineTextAlignment(.center)
            Button("Ayarları Aç") {
                if let url = URL(string: UIApplication.openSettingsURLString) {
                    UIApplication.shared.open(url)
                }
            }
            .buttonStyle(.borderedProminent)
        }
        .padding()
    }

    private var mainListView: some View {
        Group {
            if manager.isLoading && manager.assets.isEmpty {
                ProgressView("Yükleniyor…")
            } else {
                List(selection: $selection) {
                    Section {
                        ForEach(filteredSorted) { media in
                            MediaRowView(media: media, manager: manager)
                                .tag(media.id)
                        }
                    } header: {
                        HStack {
                            Text("\(filteredSorted.count) öğe")
                            Spacer()
                            Text(ByteCountFormatter.string(fromByteCount: totalSize, countStyle: .file))
                        }
                        .font(.caption)
                    }
                }
                .environment(\.editMode, .constant(.active))
                .listStyle(.plain)
                .refreshable { await manager.loadAssets() }
            }
        }
    }
}

